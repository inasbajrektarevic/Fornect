# Kopiraj u .env i popuni prije pokretanja.

# PostgreSQL konekcioni string.
DATABASE_URL=postgres://fornect:fornect@localhost:5432/fornect

# HTTP server. PORT je i port koji produkcijski reverse proxy treba
# da targetuje kad backend proxy-je iza njega — drži ih usklađenim.
PORT=3000
HOST=0.0.0.0

# Tajna za potpisivanje JWT tokena korisničkih naloga (accounts).
# Generiši nešto dugačko i nasumično, npr: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Ključ koji admin panel šalje kroz X-Admin-Key header.
ADMIN_API_KEY=change-me

# Nakon koliko minuta bez heartbeat-a se uređaj smatra offline.
DEVICE_ONLINE_THRESHOLD_MINUTES=15

# Slanje mailova.
#   log  - mail se upise u .mail-outbox/ i u log (razvoj, testovi)
#   smtp - stvarno slanje preko SMTP-a (produkcija)
# Podrazumijevano je `log`, da se pravi mail nikad ne posalje slucajno.
MAIL_TRANSPORT=log
MAIL_FROM=Fornect <no-reply@primjer.com>

# Popuniti samo uz MAIL_TRANSPORT=smtp.
# Port 465 koristi implicitni TLS, 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Da li prijava trazi potvrdjenu email adresu.
# UKLJUCITI TEK KAD SLANJE MAILOVA RADI - inace se svi postojeci
# nalozi zakljucavaju, jer kod nemaju kako dobiti.
REQUIRE_VERIFIED_EMAIL=false

# Nakon koliko sati se neklasifikovan uredjaj sam svrstava medju goste.
# Uredjaji bez ekrana (TV, stampac, konzola) nikad nece sami odgovoriti,
# pa bi red "Novi uredjaji" inace rastao zauvijek. Nula iskljucuje.
AUTO_GUEST_AFTER_HOURS=24

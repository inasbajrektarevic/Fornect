# Kopiraj u .env i popuni prije pokretanja.

# PostgreSQL konekcioni string.
DATABASE_URL=postgres://fornect:fornect@localhost:5432/fornect

# HTTP server
PORT=3000
HOST=0.0.0.0

# Tajna za potpisivanje JWT tokena korisničkih naloga (accounts).
# Generiši nešto dugačko i nasumično, npr: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Ključ koji admin panel šalje kroz X-Admin-Key header.
ADMIN_API_KEY=change-me

# Nakon koliko minuta bez heartbeat-a se uređaj smatra offline.
DEVICE_ONLINE_THRESHOLD_MINUTES=15
